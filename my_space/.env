# ============================================================
# CodeMigrator 本机环境与基础设施凭证记录（WSL2 单环境）
# 规则（AGENTS.md §1.2）：
#   1. 敏感凭证只允许存放于本文件，不得写入 AGENTS.md、代码、日志或 PR 描述。
#   2. 环境或配置更新后，必须同步回填本文件。
# 说明：本文件现为【本机 xtc@Ubuntu-22.04】的生效记录；
#       原工作主机(dev@Ubuntu-24.04)记录完整保留于文末存档段。
# ============================================================

[本机 WSL2 环境]
distro = Ubuntu 22.04.5 LTS (WSL2，发行版名 Ubuntu1-22.04)
kernel = 6.18.33.2-microsoft-standard-WSL2（>=5.15 满足）
systemd = 已启用（PID 1，is-system-running=running）
cgroup_v2 = cgroup2fs 满足
user_namespace = 可用（unshare --user --map-root-user 通过）
sudo = xtc 免密 sudo（NOPASSWD，用户 2026-08-26 配置生效）；root 步骤 agent 可直接执行
磁盘 = / 约 1007G（虚拟上限），已用 58G，可用约 899G（2026-08-26 实测）
内存_CPU = 15 GiB / 12 核
apt_源 = mirrors.aliyun.com/ubuntu jammy（本机开箱即已配置；sources.list.d 另有 nodesource/docker/cuda-local）

[工具链清单 ~/env]
# 非 apt 工具一律隔离安装在 ~/env 子目录（AGENTS.md §1.2）
rust = 1.98.0 stable（rustup minimal；RUSTUP_HOME=~/env/rustup，CARGO_HOME=~/env/cargo）
rust_镜像 = rsproxy.cn（rustup-init 脚本经 rsproxy 下载；crates.io sparse 源见 ~/env/cargo/config.toml）
node = v24.19.0（~/env/node -> node-v24.19.0-linux-x64；npmmirror 二进制下载）
pnpm = 11.24.0（npm 全局安装于 ~/env/node；registry=https://registry.npmmirror.com/）
pip_镜像 = mirrors.aliyun.com/pypi/simple（~/.config/pip/pip.conf）
系统node = /usr/bin/node v22.23.1（nodesource 装，保留不动）；PATH 托管块使 ~/env/node(v24) 优先
apt_工具 = build-essential(gcc 11.4)/pkg-config(0.29.2)/libcap-dev/libseccomp-dev/meson(0.61.2)/ninja-build/postgresql-client(14.24)；系统自带 bubblewrap 0.6.1（已被 ~/env 0.9.0 接管，见沙箱段）
PATH接线 = ~/.profile 与 ~/.bashrc 各有 ">>> CodeMigrator toolchains <<<" 托管块

[Docker]
engine = 28.3.1（本机既有安装）+ compose plugin v2.38.1；systemd 服务 active
registry_mirrors = 37 条国内镜像已生效，源自 my_space/temp/supply/docker_mirror.md
                   （生成物 my_space/temp/supply/docker_mirror.daemon.json；已去重 docker.1ms.run；
                     原配置备份于 /etc/docker/daemon.json.bak.*）
权限 = xtc 已加入 docker 组，docker 命令免 sudo
验证 = daemon.json 加载 37 条镜像；docker ps 免 sudo；hello-world 拉取+运行成功（2026-08-26）
备注 = root 步骤由 my_space/temp/local_sudo_env_setup.sh 完成执行

[沙箱前提核验记录]
# M-09 要求（架构哲学 L639）：Linux kernel>=5.15 / cgroup v2 / bubblewrap>=0.8 / user namespace 可用
结论 = 四项全部满足（2026-08-26）：kernel 6.18.33.2 / systemd / cgroup2fs / user ns 通过；
      bubblewrap 0.9.0 源码构建完成（与工作主机同版本），安装于 ~/env/bwrap/bin，
      libcap+libseccomp 支持，--unshare-all 冒烟测试通过；
      登录 shell PATH 已优先解析 ~/env 版本（系统 /usr/bin 0.6.1 不再生效）
bwrap_源码 = ~/env/src/bubblewrap-0.9.0（GitHub release 下载，失败自动回退国内代理）
备注 = 沙箱执行位公式 max(1,min(4,floor(mem/4),floor(cores/2))) 在本机 15G/12C 下 = 3
       （工作主机 7.8G/4C 为 1）

[PostgreSQL]
# Compose 三服务基线之一；控制面唯一真相源；本机 localhost 直连，无隧道
local_port =
db_user =
db_password =
db_name =
notes = 服务端尚未部署（本仓库下载件暂无根 compose.yaml），待建立 compose.yaml 后启动并回填。
        postgresql-client 14.24 已装（jammy 默认版本；服务端版本以 compose.yaml 为准）。

[可选基础设施]
# MinIO / Prometheus / Grafana / Jaeger 均为显式 Compose profile，默认关闭
minio_endpoint =
minio_access_key =
minio_secret_key =

[model API]
# 真实调用大模型用 key 见 my_space/model_api_key.json（已随迁移件就位）

