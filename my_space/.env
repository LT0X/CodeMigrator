# ============================================================
# CodeMigrator 本机环境与基础设施凭证记录（WSL2 单环境）
# 规则（AGENTS.md §1.2）：
#   1. 敏感凭证只允许存放于本文件，不得写入 AGENTS.md、代码、日志或 PR 描述。
#   2. 环境或配置更新后，必须同步回填本文件。
#
# ⚠️ 环境身份判定（读取任何配置前，必须【先】执行本节判定）：
#   本文件同时记录两台电脑的环境，配置互不相同。任何 agent/脚本在读取
#   或回填本文件前，必须先确认自己当前所在的主机，再进入对应大区：
#
#     1. 运行：  hostname  &&  whoami  &&  cat /etc/os-release
#     2. 判定：
#        - 若 hostname 对应「当前电脑 dev」→ 读取下方 [主机：dev（当前电脑）] 大区
#        - 若 hostname 对应「家庭电脑 xtc」→ 读取下方 [主机：xtc（家庭电脑）] 大区
#     3. 两套环境相互独立，各自拥有独立的 ~/env 工具链、Docker 与凭证，禁止跨区混用。
# ============================================================

# ---- 判定参照：两主机的识别要点 ----
#   dev 当前电脑 : Ubuntu 24.04 LTS / 用户 dev / WSL 发行版 Ubuntu-24.04 / 内存 7.8G / 4 核
#   xtc 家庭电脑 : Ubuntu 22.04 LTS / 用户 xtc / WSL 发行版 Ubuntu1-22.04 / 内存 15G / 12 核
#   （V5 技术栈基线对两机相同：Python 3.12+ / uv / FastAPI / SQLAlchemy 2.0+asyncpg /
#     Pydantic v2 / py-tree-sitter / app 直接调 bwrap；详见各机 [V5 技术栈基线] 小节）

# ============================================================
# ╔═══════════════════════════════════════════════════════════╗
# ║  [主机：dev（当前电脑）]                                   ║
# ╚═══════════════════════════════════════════════════════════╝
# ============================================================

[dev · 身份]
主机 = dev@Ubuntu-24.04（当前电脑 Current PC）
用户 = dev（免密 sudo NOPASSWD）
发行版 = Ubuntu 24.04 LTS，WSL 发行版 Ubuntu-24.04
判定特征 = hostname 含 dev；内存 7.8G；4 核

[dev · 本机 WSL2 环境]
kernel = 6.18.33.2-microsoft-standard-WSL2（>=5.15 满足）
systemd = 已启用（PID 1）
cgroup_v2 = cgroup2fs 满足
user_namespace = 可用（bwrap --unshare-all 冒烟通过）
vhdx_位置 = D:\wsl\Ubuntu-24.04（宿主 D 盘，动态 VHDX——df 显示的 ~1T 是虚拟上限，非真实容量）
宿主磁盘 = D 盘总 267G / 可用约 236G（2026-08-26 实测）；WSL 实际占用受宿主盘限制
wsl_配额预算 = 用户约束：分给 WSL 至多约 100G，安装大型组件前须评估占用
apt_源 = https://mirrors.aliyun.com/ubuntu（ubuntu.sources 已切换；原文件备份为同目录 ubuntu.sources.bak）

[dev · V5 技术栈基线]
# 设计文档 2026-08-27 从 Rust V4 迁移为 Python V5（零新机制，仅换语言词汇；契约真相见 M-00/M-01）
实现语言 = Python 3.12+（单包 src-layout，uv 管理，import-linter 依赖契约）
后端框架 = FastAPI / SQLAlchemy 2.0(async)+asyncpg / Pydantic v2 / asyncio / py-tree-sitter / structlog+OpenTelemetry
沙箱 = app 直接 subprocess 调 bwrap（独立 sandbox-worker/UDS 退役；bubblewrap+cgroup 不变）
前端 = React + TypeScript + Vite（不变，仍需 Node/pnpm）
部署基线 = app + PostgreSQL（bwrap 由 app 管理）

[dev · 工具链清单 ~/env]
# 非 apt 工具一律隔离安装在 ~/env 子目录（AGENTS.md §1.2）
python = 系统 /usr/bin/python3.12 (3.12.3)（uv 自动发现）
uv = 0.12.7 + uvx（~/env/uv；PyPI 源=清华 TUNA，见 ~/.config/uv/uv.toml；PATH 由安装器 source ~/env/uv/env）
rust = 1.98.0 stable（rustup minimal；RUSTUP_HOME=~/env/rustup，CARGO_HOME=~/env/cargo；V5 后端弃用，经用户确认保留不动）
rust_镜像 = rsproxy.cn（rustup 安装脚本与 crates.io sparse 源，见 ~/env/cargo/config.toml）
node = v24.19.0（~/env/node -> node-v24.19.0-linux-x64；npmmirror；Web 前端仍需要）
pnpm = 11.24.0（npm 全局安装；registry=https://registry.npmmirror.com/）
apt_工具 = build-essential(gcc 13.3)/pkg-config/libssl-dev/postgresql-client(16.15)/bubblewrap(0.9.0)
PATH接线 = ~/.profile 与 ~/.bashrc 各有 ">>> CodeMigrator toolchains <<<" 托管块 + uv 安装器 source ~/env/uv/env

[dev · Docker]
engine = docker-ce 29.7.2（apt 源：mirrors.aliyun.com/docker-ce/linux/ubuntu）
compose = docker compose plugin v5.5.0
daemon_json = /etc/docker/daemon.json registry-mirrors 共 37 条，
              来源 my_space/temp/supply/docker_mirror.md（已去除重复条目）
权限 = dev 已加入 docker 组（免 sudo）
验证 = hello-world 拉取成功；registry-mirrors 加载 37 条

[dev · 沙箱前提核验记录]
# M-09 要求：Linux kernel>=5.15 / cgroup v2 / bubblewrap>=0.8 / user namespace 可用
结论 = 四项全部满足（2026-08-26）：kernel 6.18.33.2 / systemd / cgroup2fs / user ns 通过；
      bubblewrap 0.9.0 --unshare-all 冒烟测试通过
备注 = 沙箱执行位公式 max(1,min(4,floor(mem/4),floor(cores/2))) 在本机 7.8G/4C 下 = 1

[dev · PostgreSQL]
# Compose 基线之一；控制面唯一真相源；本机 localhost 直连，无隧道
local_port =
db_user =
db_password =
db_name =
notes = 服务端尚未部署，待批次1建立仓库根 compose.yaml 后启动并回填

[dev · 可选基础设施]
# MinIO / Prometheus / Grafana / Jaeger 均为显式 Compose profile，默认关闭
minio_endpoint =
minio_access_key =
minio_secret_key =

[dev · model API]
# 真实调用大模型用 key 见 my_space/model_api_key.json

